    {
      "id": "c2iHUdBOMorrcmZFg4IOa",
      "type": "text",
      "x": 495.23064406400965,
      "y": -154.29091395816974,
      "width": 383.9353755954845,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
